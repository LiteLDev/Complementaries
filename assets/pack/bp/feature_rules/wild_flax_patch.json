{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "complementaries:wild_flax_patch",
      "places_feature": "complementaries:wild_flax_feature"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {"test": "has_biome_tag", "operator": "==", "value": "plains"},
            {"test": "has_biome_tag", "operator": "==", "value": "savanna"},
            {"test": "has_biome_tag", "operator": "==", "value": "river"},
            {"test": "has_biome_tag", "operator": "==", "value": "beach"},
            {"test": "has_biome_tag", "operator": "==", "value": "swamp"}
          ]
        },
        {"test": "has_biome_tag", "operator": "!=", "value": "frozen"},
        {"test": "has_biome_tag", "operator": "!=", "value": "cold"}
      ]
    },
    "distribution": {
      "iterations": 1,
      "scatter_chance": {
        "numerator": 1,
        "denominator": 8
      },
      "x": {
        "distribution": "uniform",
        "extent": [0, 16]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz)",
      "z": {
        "distribution": "uniform",
        "extent": [0, 16]
      }
    }
  }
}
