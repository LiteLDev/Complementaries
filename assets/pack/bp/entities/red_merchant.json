{
  "format_version": "1.21.60",
  "minecraft:entity": {
    "description": {
      "identifier": "complementaries:red_merchant",
      "is_spawnable": true,
      "is_summonable": true,
      "spawn_category": "creature"
    },
    "component_groups": {
      "complementaries:despawning": {
        "minecraft:type_family": { "family": ["red_merchant", "red_merchant_despawning", "mob"] }
      },
      "complementaries:angry": {
        "minecraft:angry": {
          "duration": 30,
          "broadcast_anger": false,
          "calm_event": { "event": "complementaries:become_calm", "target": "self" }
        },
        "minecraft:behavior.hurt_by_target": { "priority": 1 },
        "minecraft:behavior.ranged_attack": {
          "priority": 2,
          "attack_interval_min": 1.5,
          "attack_interval_max": 2.5,
          "attack_radius": 12.0,
          "speed_multiplier": 0.6
        },
        "minecraft:shooter": { "def": "complementaries:bomb" }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["red_merchant", "mob"] },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:movement": { "value": 0.5 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "avoid_water": true,
        "can_open_doors": true,
        "can_pass_doors": true,
        "can_path_over_water": true
      },
      "minecraft:trade_table": {
        "display_name": "entity.complementaries:red_merchant.name",
        "table": "trading/red_merchant_trades.json",
        "new_screen": true,
        "persist_trades": true
      },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "entity_explosion", "deals_damage": "no" },
          { "cause": "block_explosion", "deals_damage": "no" },
          {
            "cause": "all",
            "deals_damage": "yes",
            "on_damage": {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "event": "complementaries:become_angry"
            }
          }
        ]
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          { "cause": "lava", "damage_per_tick": 4, "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true } }
        ]
      },
      "minecraft:despawn": {
        "remove_child_entities": true,
        "filters": {
          "all_of": [
            { "test": "is_family", "subject": "self", "value": "red_merchant_despawning" },
            { "test": "distance_to_nearest_player", "operator": ">", "value": 24 }
          ]
        }
      },
      "minecraft:timer": {
        "looping": false,
        "random_time_choices": [{ "value": 1200, "weight": 50 }, { "value": 1800, "weight": 50 }],
        "time_down_event": { "event": "complementaries:start_despawn", "target": "self" }
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.trade_with_player": {
        "priority": 1,
        "filters": {
          "all_of": [
            { "test": "in_water", "value": false },
            { "test": "on_ground", "value": true },
            { "test": "has_component", "subject": "self", "operator": "!=", "value": "minecraft:angry" }
          ]
        }
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 3,
        "max_dist": 6,
        "walk_speed_multiplier": 0.6,
        "sprint_speed_multiplier": 0.6,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "zombie" },
                { "test": "is_family", "subject": "other", "value": "zombie_villager" },
                { "test": "is_family", "subject": "other", "value": "illager" },
                { "test": "is_family", "subject": "other", "value": "vex" }
              ]
            }
          }
        ]
      },
      "minecraft:behavior.look_at_trading_player": { "priority": 4 },
      "minecraft:behavior.open_door": { "priority": 6, "close_door_after": true },
      "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 0.5 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 8 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },
    "events": {
      "complementaries:become_angry": { "add": { "component_groups": ["complementaries:angry"] } },
      "complementaries:become_calm": { "remove": { "component_groups": ["complementaries:angry"] } },
      "complementaries:start_despawn": { "add": { "component_groups": ["complementaries:despawning"] } }
    }
  }
}
