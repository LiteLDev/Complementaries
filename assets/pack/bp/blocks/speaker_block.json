{
  "format_version": "1.26.20",
  "minecraft:block": {
    "description": {
      "identifier": "complementaries:speaker_block",
      "menu_category": { "category": "items" },
      "states": {
        "complementaries:powered": [false, true]
      },
      "traits": {
        "minecraft:placement_direction": { "enabled_states": ["minecraft:cardinal_direction"], "y_rotation_offset": 180 }
      }
    },
    "components": {
      "minecraft:display_name": "tile.complementaries:speaker_block.name",
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 1.0 },
      "minecraft:destructible_by_explosion": { "explosion_resistance": 1.0 },
      "minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 20 },
      "minecraft:map_color": "#8f6b40",
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": { "texture": "complementaries_speaker_block_side", "render_method": "opaque" },
        "up": { "texture": "complementaries_speaker_block_top", "render_method": "opaque" },
        "north": { "texture": "complementaries_speaker_block_front", "render_method": "opaque" }
      },
      "minecraft:redstone_conductivity": { "redstone_conductor": false, "allows_wire_to_step_down": true },
      "minecraft:redstone_consumer": { "min_power": 0, "propagates_power": false },
      "minecraft:movable": { "movement_type": "immovable" }
    },
    "permutations": [
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'north'", "components": { "minecraft:transformation": { "rotation": [0, 0, 0] } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'west'", "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'south'", "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } } },
      { "condition": "q.block_state('minecraft:cardinal_direction') == 'east'", "components": { "minecraft:transformation": { "rotation": [0, -90, 0] } } }
    ]
  }
