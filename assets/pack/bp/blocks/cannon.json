{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "complementaries:cannon",
      "menu_category": { "category": "equipment" },
      "traits": {
        "minecraft:placement_position": { "enabled_states": ["minecraft:block_face"] }
      }
    },
    "components": {
      "minecraft:geometry": "geometry.complementaries.cannon",
      "minecraft:material_instances": {
        "*": { "texture": "complementaries_cannon", "render_method": "alpha_test" }
      },
      "minecraft:collision_box": { "origin": [-7, 0, -7], "size": [14, 10, 14] },
      "minecraft:selection_box": { "origin": [-7, 0, -7], "size": [14, 12, 14] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 3.5 },
      "minecraft:destructible_by_explosion": { "explosion_resistance": 6 },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#3b3d44",
      "minecraft:redstone_consumer": { "min_power": 1, "propagates_power": false }
    },
    "permutations": [
      { "condition": "q.block_state('minecraft:block_face') == 'down'", "components": { "minecraft:transformation": { "rotation": [180, 0, 0] } } },
      { "condition": "q.block_state('minecraft:block_face') == 'north'", "components": { "minecraft:transformation": { "rotation": [270, 0, 0] } } },
      { "condition": "q.block_state('minecraft:block_face') == 'south'", "components": { "minecraft:transformation": { "rotation": [90, 0, 0] } } },
      { "condition": "q.block_state('minecraft:block_face') == 'east'", "components": { "minecraft:transformation": { "rotation": [0, 0, 270] } } },
      { "condition": "q.block_state('minecraft:block_face') == 'west'", "components": { "minecraft:transformation": { "rotation": [0, 0, 90] } } }
    ]
  }
}
