{
  "format_version": "1.26.0",
  "minecraft:block": {
    "description": {
      "identifier": "complementaries:turn_table",
      "menu_category": {
        "category": "items"
      },
      "states": {
        "complementaries:inverted": [
          false,
          true
        ],
        "complementaries:rotating": [
          false,
          true
        ]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:facing_direction"
          ]
        }
      }
    },
    "components": {
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": {
          "texture": "cm_turn_table_side",
          "render_method": "opaque"
        },
        "up": {
          "texture": "cm_turn_table_top",
          "render_method": "opaque"
        },
        "down": {
          "texture": "cm_turn_table_bottom",
          "render_method": "opaque"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6
      },
      "minecraft:redstone_consumer": {
        "min_power": 1,
        "propagates_power": false
      },
      "minecraft:loot": "loot_tables/blocks/turn_table.json",
      "minecraft:map_color": "#7b7b7b"
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'down'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'up'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              180,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              270,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              270
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              90
            ]
          }
        }
      },
      {
        "condition": "q.block_state('complementaries:inverted') == false && q.block_state('complementaries:rotating') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cm_turn_table_side",
              "render_method": "opaque"
            },
            "up": {
              "texture": "cm_turn_table_top",
              "render_method": "opaque"
            },
            "down": {
              "texture": "cm_turn_table_bottom",
              "render_method": "opaque"
            }
          }
        }
      },
      {
        "condition": "q.block_state('complementaries:inverted') == false && q.block_state('complementaries:rotating') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cm_turn_table_side",
              "render_method": "opaque"
            },
            "up": {
              "texture": "cm_turn_table_top_on",
              "render_method": "opaque"
            },
            "down": {
              "texture": "cm_turn_table_bottom",
              "render_method": "opaque"
            }
          }
        }
      },
      {
        "condition": "q.block_state('complementaries:inverted') == true && q.block_state('complementaries:rotating') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cm_turn_table_side",
              "render_method": "opaque"
            },
            "up": {
              "texture": "cm_turn_table_top_inverted",
              "render_method": "opaque"
            },
            "down": {
              "texture": "cm_turn_table_bottom",
              "render_method": "opaque"
            }
          }
        }
      },
      {
        "condition": "q.block_state('complementaries:inverted') == true && q.block_state('complementaries:rotating') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "cm_turn_table_side",
              "render_method": "opaque"
            },
            "up": {
              "texture": "cm_turn_table_top_inverted_on",
              "render_method": "opaque"
            },
            "down": {
              "texture": "cm_turn_table_bottom",
              "render_method": "opaque"
            }
          }
        }
      }
    ]
  }
}
