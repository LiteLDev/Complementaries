          "flame_wall_a": "!(q.block_state('minecraft:block_face') == 'up') && q.block_state('complementaries:lit')",
          "flame_wall_b": "!(q.block_state('minecraft:block_face') == 'up') && q.block_state('complementaries:lit')",
