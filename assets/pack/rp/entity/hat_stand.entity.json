{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "complementaries:hat_stand",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/complementaries/hat_stand" },
      "geometry": { "default": "geometry.complementaries.hat_stand" },
      "scripts": {
        "pre_animation": [
          "v.yaw = q.property('complementaries:yaw') * 22.5;",
          "v.skibidi = q.property('complementaries:skibidi');"
        ],
        "animate": [
          "base",
          "hit_controller",
          "swing_controller",
          { "skibidi": "v.skibidi > 0" }
        ]
      },
      "animations": {
        "base": "animation.complementaries.hat_stand.base",
        "wobble": "animation.complementaries.hat_stand.wobble",
        "swing": "animation.complementaries.hat_stand.swing",
        "skibidi": "animation.complementaries.hat_stand.skibidi",
        "hit_controller": "controller.animation.complementaries.hat_stand.hit",
        "swing_controller": "controller.animation.complementaries.hat_stand.swing"
      },
      "render_controllers": ["controller.render.default"],
      "enable_attachables": true,
      "spawn_egg": { "base_color": "#9c7a4c", "overlay_color": "#5d4427" }
    }
  }
}
